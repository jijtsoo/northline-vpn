<Window x:Class="OpenVpnClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenVpnClient.ViewModels"
        Title="Northline"
        Width="108" Height="28"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="Ink" Color="#F4F6FB"/>
        <SolidColorBrush x:Key="Muted" Color="#9AA3B8"/>
        <SolidColorBrush x:Key="Accent" Color="#6C9BFF"/>
    </Window.Resources>

    <Grid x:Name="Root" MouseEnter="Shell_MouseEnter" MouseLeave="Shell_MouseLeave">
        <Border x:Name="Shell" CornerRadius="24" Background="#E6101218" BorderBrush="#33FFFFFF" BorderThickness="1" VerticalAlignment="Top" Padding="0,6">
            <Grid>
                <StackPanel x:Name="Pill" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#6C9BFF" Margin="0,0,8,0"/>
                    <TextBlock x:Name="PillText" Text="VPN" FontSize="11" FontWeight="SemiBold" Foreground="#F4F6FB" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid x:Name="Strip" Visibility="Collapsed" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StripDot" Grid.Column="0" Width="8" Height="8" Fill="#6C9BFF" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding StatusDetail, Mode=OneWay}"/>
                            <Run Text="{Binding DurationText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <ComboBox Grid.Column="2" Width="160" Height="30" Margin="0,0,8,0"
                              ItemsSource="{Binding Configs}"
                              SelectedItem="{Binding SelectedConfig}"
                              DisplayMemberPath="Name"
                              VerticalAlignment="Center"
                              Background="#1A2030" Foreground="#F4F6FB" BorderBrush="#2A3142"/>

                    <Button Grid.Column="3" Content="+" Width="30" Height="30" Margin="0,0,8,0"
                            Command="{Binding AddConfigCommand}" Cursor="Hand" ToolTip="Add profile">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" Background="#1A2030" CornerRadius="10" BorderBrush="#2A3142" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="#243049"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="4" MinWidth="96" Height="30" Cursor="Hand" Command="{Binding ConnectCommand}" FontSize="12" FontWeight="SemiBold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="Connect"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" Background="#5B8CFF" CornerRadius="10" Padding="12,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="#3A2428"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="#243049"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Content" Value="Disconnect"/>
                                        <Setter Property="Foreground" Value="#FF9B9B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                        <Setter Property="Content" Value="Cancel"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="AuthCard" VerticalAlignment="Top" Margin="0,64,0,0" Visibility="Collapsed"
                Background="#F2141822" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="16" Padding="16">
            <StackPanel>
                <TextBlock Text="Sign in" Foreground="#F4F6FB" FontWeight="SemiBold" FontSize="13"/>
                <TextBox Height="32" Margin="0,10,0,8" Padding="8,0" VerticalContentAlignment="Center"
                         Background="#10141C" Foreground="#F4F6FB" BorderBrush="#2A3142"
                         Text="{Binding AuthUsername, UpdateSourceTrigger=PropertyChanged}"/>
                <PasswordBox x:Name="PasswordBox" Height="32" Margin="0,0,0,8"
                             Background="#10141C" Foreground="#F4F6FB" BorderBrush="#2A3142"/>
                <CheckBox Content="Remember" IsChecked="{Binding RememberLogin}" Foreground="#C9D0E0" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="72" Height="28" Margin="0,0,8,0" Command="{Binding CancelAuthCommand}" Cursor="Hand"/>
                    <Button Content="Connect" Width="80" Height="28" Click="ConfirmAuth_Click" Cursor="Hand"/>
                </StackPanel>
                <Button Content="Forget saved login" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Command="{Binding ForgetLoginCommand}" Background="Transparent" BorderThickness="0"
                        Foreground="#8B93A7" Cursor="Hand" FontSize="11"
                        Visibility="{Binding SelectionHasSavedAuth, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
